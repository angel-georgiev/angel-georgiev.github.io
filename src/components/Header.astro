---
import { load, inPhase } from '../lib/content';
const site = await load('site');
const path = Astro.url.pathname;
const nav = site.nav.filter(inPhase);
---
<header class="site-header wrap">
  <a class="wordmark" href="/">{site.person.name.bg}<span class="dot" aria-hidden="true">.</span></a>
  <nav>
    <ul>
      {nav.map((n) => (
        <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.bg}</a></li>
      ))}
    </ul>
  </nav>
</header>
<style>
  .site-header {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 0.25rem 1.5rem; padding-block: 1.1rem;
  }
  .wordmark {
    font-family: var(--font-display); font-weight: 850; font-size: 1.3rem; letter-spacing: -0.01em;
    color: var(--text); text-decoration: none; padding-block: 0.2rem;
  }
  .dot { color: var(--gold); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
  nav a {
    display: inline-block; padding: 0.4rem 0; min-height: 24px;
    color: var(--text); font-weight: 700; text-decoration: none; font-size: 0.95rem;
  }
  nav a:hover { text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 2px; }
  nav a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--gold); text-decoration-thickness: 2px; }
  @media (max-width: 519px) {
    .site-header { flex-direction: column; align-items: flex-start; }
    ul { gap: 0 1.1rem; }
  }
</style>
