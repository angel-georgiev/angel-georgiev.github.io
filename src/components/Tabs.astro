---
// WAI-ARIA tabs (PRD §8): roving tabindex, ←/→/Home/End, automatic activation.
// Without JS every panel is shown in order with its own heading, and the tab list is hidden.
interface Props { id: string; tabs: { key: string; label: string }[]; label: string }
const { id, tabs, label } = Astro.props;
---
<div class="tabs" data-tabs id={id}>
  <div class="tablist" role="tablist" aria-label={label} hidden>
    {tabs.map((t, i) => (
      <button type="button" role="tab" id={`${id}-tab-${t.key}`} aria-controls={`${id}-panel-${t.key}`}
        aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
    ))}
  </div>
  <slot />
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[role="tablist"]')!;
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    list.hidden = false;
    root.dataset.enhanced = '';
    panels.forEach((p, i) => { p.setAttribute('role', 'tabpanel'); p.setAttribute('aria-labelledby', tabs[i].id); p.tabIndex = 0; });
    const select = (i: number, focus = true) => {
      tabs.forEach((t, j) => { const on = i === j; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1; panels[j].hidden = !on; });
      if (focus) tabs[i].focus();
    };
    select(0, false);
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const k = e.key; const n = tabs.length;
        const j = k === 'ArrowRight' ? (i + 1) % n : k === 'ArrowLeft' ? (i - 1 + n) % n : k === 'Home' ? 0 : k === 'End' ? n - 1 : -1;
        if (j >= 0) { e.preventDefault(); select(j); }
      });
    });
  });
</script>
<style>
  .tablist { display: flex; flex-wrap: wrap; gap: 0.4rem; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem; margin-bottom: 1.25rem; }
  .tablist[hidden] { display: none; }
  [role='tab'] {
    font: inherit; font-weight: 700; font-size: 0.9rem; color: var(--text); background: var(--surface);
    border: 1px solid var(--border); border-radius: 999px; padding: 0.45rem 0.95rem; min-height: 40px; cursor: pointer;
  }
  [role='tab'][aria-selected='true'] { background: var(--gold); color: var(--on-gold); border-color: var(--gold); }
  @media (max-width: 719px) {
    .tablist { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); }
    .tablist::-webkit-scrollbar { display: none; }
    [role='tab'] { flex: none; }
  }
</style>
