---
import { nbsp } from '../lib/content';
interface Props { items: { value: string; label: string }[] }
const { items } = Astro.props;
---
<ul class="numbers">
  {items.map((n) => <li><span class="num">{nbsp(n.value)}</span><span class="label">{n.label}</span></li>)}
</ul>
<style>
  .numbers { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .numbers { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; } }
  li { border-left: 3px solid var(--gold); padding: 0.2rem 0 0.2rem 0.9rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .num { font-family: var(--font-display); font-weight: 850; font-size: clamp(1.9rem, 4vw, 2.6rem); line-height: 1; white-space: nowrap; }
  .label { font-size: 0.85rem; color: var(--text-muted); line-height: 1.4; }
</style>
