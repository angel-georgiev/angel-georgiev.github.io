---
// PRD §5.1: three fixed lines; line 3 rotates every 2.4 s. All items share one grid cell (invisible ghosts),
// so the box always equals the longest item: zero layout shift. Reduced motion: first item only, no JS rotation.
interface Props { lines: string[]; rotating: string[] }
const { lines, rotating } = Astro.props;
---
<h1 class="rot-h1">
  {lines.map((l) => <span class="line">{l}</span>)}
  <span class="line rot" aria-live="off" data-rotator>
    {rotating.map((r, i) => <span class:list={['item', { on: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>{r}</span>)}
  </span>
</h1>
<script>
  const box = document.querySelector<HTMLElement>('[data-rotator]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (box && !reduce.matches) {
    const items = Array.from(box.querySelectorAll<HTMLElement>('.item'));
    let i = 0;
    const timer = window.setInterval(() => {
      if (reduce.matches) return window.clearInterval(timer);
      items[i].classList.remove('on'); items[i].setAttribute('aria-hidden', 'true');
      i = (i + 1) % items.length;
      items[i].classList.add('on'); items[i].removeAttribute('aria-hidden');
    }, 2400);
  }
</script>
<style>
  .rot-h1 { display: flex; flex-direction: column; font-size: clamp(2.25rem, 6vw, 4rem); line-height: 1.02; margin-bottom: 1.1rem; }
  .line { display: block; white-space: nowrap; }
  .rot { display: grid; color: var(--gold-text); }
  .item {
    grid-area: 1 / 1; white-space: nowrap; visibility: hidden; opacity: 0; transform: translateY(0.18em);
    transition: opacity 0.3s ease, transform 0.3s ease, visibility 0s linear 0.3s;
  }
  .item.on { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
</style>
