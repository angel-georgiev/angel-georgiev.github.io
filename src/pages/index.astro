---
import Base from '../layouts/Base.astro';
import RotatingH1 from '../components/RotatingH1.astro';
import Btn from '../components/Btn.astro';
import Pic from '../components/Pic.astro';
import Numbers from '../components/Numbers.astro';
import Motif from '../components/Motif.astro';
import SectionHead from '../components/SectionHead.astro';
import OfferCard from '../components/landing/OfferCard.astro';
import { Picture } from 'astro:assets';
import { load, photo, inPhase, nbsp } from '../lib/content';
import { profilePage } from '../lib/jsonld';

const l = await load('landing');
const site = await load('site');
const { offers } = await load('offers');
const ph = await photo(l.hero.photo);
const covers = import.meta.glob<{ default: ImageMetadata }>('/src/assets/book/*', { eager: true });
const cover = covers[`/src/assets/book/${site.book.cover.file}`]?.default;
if (!cover) throw new Error(`book cover missing: src/assets/book/${site.book.cover.file}`);

// Lede with the bold phrase (landing.yml: lede + lede_bold)
const [ledeA, ...ledeRest] = l.hero.lede.split(l.hero.lede_bold);
if (!ledeRest.length) throw new Error('landing.yml: hero.lede_bold is not part of hero.lede');
const order = ['session', 'school-training', 'companies', 'events'];
const cards = order.map((k) => {
  const o = offers.find((x) => x.key === k);
  if (!o) throw new Error(`offers.yml: missing offer "${k}"`);
  return o;
});
const jsonld = await profilePage(Astro.site!, new URL('/', Astro.site).href);
---
<Base theme="dark" title={l.meta.title} description={l.meta.description} credit={ph.credit} jsonld={jsonld} ogImage="/og/index.png">
  <div class="wrap">
    <section class="hero home-hero">
      <div class="hero-text">
        <a class="pill" href={l.hero.award_href}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="14" height="14"><path fill="currentColor" d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"/></svg>
          {l.hero.award}
        </a>
        <RotatingH1 lines={l.hero.h1_static_lines} rotating={l.hero.h1_rotating} />
        <p class="lede">{nbsp(ledeA)}<strong>{nbsp(l.hero.lede_bold)}</strong>{nbsp(ledeRest.join(l.hero.lede_bold))}</p>
        <div class="cta-row">
          <Btn variant="gold" text={l.hero.cta_primary.text} small={l.hero.cta_primary.small} href={l.hero.cta_primary.href} />
          <Btn variant="outline" text={l.hero.cta_secondary.text} small={l.hero.cta_secondary.small} href={l.hero.cta_secondary.href} />
        </div>
        <a class="textlink resume-link" href={l.hero.textlink.href}>{l.hero.textlink.text}</a>
      </div>
      <div class="hero-photo">
        <Pic id={l.hero.photo} aspect={[4, 5]} eager sizes="(min-width: 900px) 512px, calc(100vw - 32px)" maxWidth={1024} />
        <p class="badge"><span class="v">{nbsp(l.hero.badge.value)}</span><span class="t">{l.hero.badge.label}</span></p>
      </div>
    </section>

    <section class="numbers-wrap" aria-label={l.hero.badge.label}>
      <Numbers items={l.numbers} />
    </section>

    <Motif />

    <section class="grid-3 perspectives">
      {l.perspectives.map((p) => (
        <article class="card"><h2 class="persp-title">{p.title}</h2><p>{p.text}</p></article>
      ))}
    </section>

    <section class="section" id={l.offers.id}>
      <SectionHead kicker={l.offers.kicker} h2={l.offers.h2} intro={l.offers.intro} />
      <div class="grid-2 offers">
        {cards.filter(inPhase).map((o) => <OfferCard offer={o} featured={o.key === 'session'} teaser={o.key === 'companies'} />)}
      </div>
    </section>

    <section class="section">
      <SectionHead kicker={l.in_action.kicker} h2={l.in_action.h2} intro={nbsp(l.in_action.intro)} />
      <ul class="clips">
        {l.in_action.items.map((c) => (
          <li>
            <a class="clip card" href={c.url}>
              <span class="src">
                <svg aria-hidden="true" viewBox="0 0 24 24" width="28" height="28"><circle cx="12" cy="12" r="11" fill="var(--gold)"/><path d="M10 8l6 4-6 4z" fill="var(--on-gold)"/></svg>
                {c.src}
              </span>
              <span class="title">{c.title}</span>
              <span class="meta">{c.meta}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="also">{l.in_action.also}</p>
    </section>

    <section class="section">
      <div class="book card">
        <Picture src={cover} alt={site.book.cover.alt} width={240} widths={[240, 471]} sizes="(min-width: 760px) 240px, 180px" formats={['avif', 'webp']} class="cover" loading="lazy" />
        <div>
          <p class="kicker">{l.book.kicker}</p>
          <h2>{l.book.h2}</h2>
          <p class="muted">{l.book.text}</p>
          <Btn variant="outline" text={l.book.cta.text} href={l.book.cta.href} />
        </div>
      </div>
    </section>
  </div>
  {inPhase(l.daskal_banner) && <a class="daskal-banner" href={l.daskal_banner.href}>{l.daskal_banner.text}</a>}
</Base>

<style>
  .home-hero { padding-top: 1.5rem; }
  .pill {
    display: inline-flex; align-items: center; gap: 0.45rem; background: var(--gold); color: var(--on-gold);
    font-size: 0.72rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none;
    padding: 0.4rem 0.85rem; border-radius: 999px; margin-bottom: 1.1rem; min-height: 28px;
  }
  .pill:hover { text-decoration: underline; }
  .lede { margin-bottom: 1.4rem; }
  .resume-link { margin-top: 0.9rem; }
  .hero-photo .badge {
    position: absolute; top: 1rem; right: 1rem; margin: 0; background: var(--gold); color: var(--on-gold);
    border-radius: 14px; padding: 0.6rem 0.85rem; display: flex; flex-direction: column; align-items: center; box-shadow: 0 6px 20px rgb(0 0 0 / 0.25);
  }
  .badge .v { font-family: var(--font-display); font-weight: 900; font-size: 1.5rem; line-height: 1; }
  .badge .t { font-size: 0.7rem; font-weight: 600; }
  .numbers-wrap { border-top: 1px solid var(--border); margin-top: 2rem; padding-top: 2rem; }
  .perspectives .card { padding: 1.3rem 1.4rem; }
  .persp-title { font-size: 1.35rem; color: var(--gold-text); margin-bottom: 0.4rem; }
  .perspectives p { font-size: 0.9rem; color: var(--text-muted); margin: 0; }
  .offers { gap: 1rem; }
  .clips { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .clips { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1000px) { .clips { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .clip { display: flex; flex-direction: column; gap: 0.6rem; height: 100%; text-decoration: none; color: var(--text); transition: border-color var(--ease); }
  .clip:hover { border-color: var(--gold); }
  .src { display: flex; align-items: center; gap: 0.6rem; font-weight: 800; }
  .title { font-size: 0.9rem; color: var(--text-muted); }
  .meta { margin-top: auto; font-size: 0.7rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-muted); }
  .also { margin-top: 1rem; font-size: 0.85rem; font-weight: 600; max-width: none; }
  .book { display: grid; gap: 1.5rem; align-items: center; padding: clamp(1.25rem, 3vw, 2rem); }
  @media (min-width: 760px) { .book { grid-template-columns: 240px 1fr; gap: 2.5rem; } }
  .book :global(.cover) { width: 180px; height: auto; border-radius: 4px; box-shadow: 0 10px 30px rgb(0 0 0 / 0.35); }
  @media (min-width: 760px) { .book :global(.cover) { width: 240px; } }
  .daskal-banner { display: block; text-align: center; padding: 0.9rem var(--gutter); margin-top: 2.5rem; background: var(--surface); border-block: 1px solid var(--border); color: var(--gold-text); font-weight: 800; text-decoration: none; }
  .daskal-banner:hover { text-decoration: underline; }
</style>
