---
import '@fontsource-variable/sofia-sans/wght.css';
import '@fontsource-variable/sofia-sans/wght-italic.css';
import '@fontsource-variable/sofia-sans-condensed/wght.css';
import '../styles/global.css';
import bodyFont from '@fontsource-variable/sofia-sans/files/sofia-sans-cyrillic-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { load } from '../lib/content';

interface Props {
  title: string;
  description: string;
  theme: 'dark' | 'light';   // fixed per page (PRD §6.2), set server-side
  credit?: string;           // photo credit of the page's one photo
  noindex?: boolean;
  canonical?: string;        // absolute URL; defaults to this page on the configured site
  jsonld?: object | object[];
  ogImage?: string;          // path under the site, e.g. /og/index.png
  bare?: boolean;            // no header/footer (redirect pages)
  noTracking?: boolean;      // never load analytics (e.g. /support/thanks/)
}
const { title, description, theme, credit, noindex = false, canonical, jsonld, ogImage, bare = false, noTracking = false } = Astro.props;
const site = await load('site');
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const og = ogImage ? new URL(ogImage, Astro.site).href : undefined;
const cfToken = site.analytics.cloudflare_token.trim();
const analytics = !noTracking && !bare && /^[0-9a-f]{32}$/i.test(cfToken);
if (cfToken && !/^[0-9a-f]{32}$/i.test(cfToken)) throw new Error('site.yml: analytics.cloudflare_token must be the 32-character hex token from Cloudflare');
---
<!doctype html>
<html lang="bg" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={theme === 'dark' ? '#10261D' : '#F4EFE4'} />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content={site.person.name.bg} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {og && <meta property="og:image" content={og} />}
    {og && <meta property="og:image:width" content="1200" />}
    {og && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={og ? 'summary_large_image' : 'summary'} />
    <slot name="head" />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    {analytics && <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: cfToken })}></script>}
  </head>
  <body>
    {bare ? <slot /> : (
      <>
        <a class="skip-link" href="#main">{site.ui.skip_link.bg}</a>
        <slot name="top" />
        <Header />
        <main id="main" tabindex="-1"><slot /></main>
        <Footer credit={credit} />
      </>
    )}
  </body>
</html>
