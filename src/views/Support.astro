---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import CheckList from '../components/CheckList.astro';
import Steps from '../components/Steps.astro';
import SupportCta from '../components/SupportCta.astro';
import OfferCard from '../components/landing/OfferCard.astro';
import { load, photo, inPhase, nbsp } from '../lib/content';
import { visibleTestimonials } from '../lib/rules';
import { person } from '../lib/jsonld';

import { langFromPath } from '../lib/i18n';
const lang = langFromPath(Astro.url.pathname);
const s = await load('support', lang);
const { offers } = await load('offers', lang);
const pg = s.page;
const ph = await photo(pg.proof.photo, lang);
const [h1Before] = pg.h1.split(pg.h1_highlight);
const forWhat = pg.for_what.items.filter(inPhase).map((x) => (typeof x === 'string' ? x : x.text));
const testimonials = visibleTestimonials(pg.proof.testimonials.items, pg.proof.testimonials.min_to_show);
const ladder = ['session', 'school-training'].map((k) => {
  const o = offers.find((x) => x.key === k);
  if (!o) throw new Error(`offers.yml: missing offer "${k}"`);
  return o;
});

const p = await person(Astro.site!, lang);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s.product.name,
  description: `${s.meta.description} ${pg.guarantee.text}`,
  serviceType: s.product.format,
  areaServed: { '@type': 'Country', name: 'BG' },
  provider: p,
  url: new URL(Astro.url.pathname, Astro.site).href,
  inLanguage: lang,
  offers: { '@type': 'Offer', price: String(s.product.price_eur), priceCurrency: 'EUR', description: pg.price.includes },
};
---
<Base theme="dark" title={s.meta.title} description={s.meta.description} credit={ph.credit} jsonld={jsonld} ogImage={lang === 'en' ? '/og/en-support.png' : '/og/support.png'}>
  <div class="wrap">
    <!-- 1. eyebrow, H1, intro -->
    <section class="intro">
      <p class="kicker">{pg.eyebrow}</p>
      <h1>{h1Before.trim()} <span class="hl">{pg.h1_highlight}</span></h1>
      <p class="lede">{pg.intro}</p>
    </section>

    <!-- 2–3. outcome, what I can help with -->
    <section class="section grid-2 two">
      <div><h2>{pg.outcome.heading}</h2><CheckList items={pg.outcome.items.map(nbsp)} /></div>
      <div><h2>{pg.for_what.heading}</h2><CheckList items={forWhat} /></div>
    </section>

    <!-- 4. for whom / not for -->
    <section class="section grid-2 two">
      <div class="card"><h2 class="h3">{pg.for_whom.heading}</h2><CheckList items={pg.for_whom.items} /></div>
      <div class="card"><h2 class="h3">{pg.not_for.heading}</h2><CheckList items={pg.not_for.items} marker="ring" /></div>
    </section>

    <!-- 5. proof (+ the page's only photo) -->
    <section class="section proof">
      <div>
        <h2>{pg.proof.heading}</h2>
        <CheckList items={pg.proof.items.map((i) => ({ text: nbsp(i.text), href: i.href }))} />
      </div>
      <Pic id={pg.proof.photo} aspect={[3, 2]} sizes="(min-width: 900px) 520px, calc(100vw - 32px)" maxWidth={1100} class="proof-photo" />
    </section>

    <!-- 6. testimonials: not rendered at all below the threshold -->
    {testimonials.length > 0 && (
      <section class="section">
        <ul class="testimonials grid-3">
          {testimonials.map((t) => (
            <li class="card"><blockquote><p>{t.text}</p></blockquote><p class="who">{t.name}{t.role && <span class="muted"> · {t.role}</span>}</p></li>
          ))}
        </ul>
      </section>
    )}

    <!-- 7. first CTA -->
    <section class="section"><SupportCta id="cta" /></section>

    <!-- 8. how it works -->
    <section class="section">
      <h2>{pg.how.heading}</h2>
      <Steps items={pg.how.steps.map(nbsp)} cols={4} />
    </section>

    <!-- 9–10. guarantee, price -->
    <section class="section grid-2 two">
      <div class="card guarantee"><h2 class="h3">{pg.guarantee.heading}</h2><p>{pg.guarantee.text}</p></div>
      <div class="price-card">
        <p class="kicker">{pg.price.label}</p>
        <p class="price">{nbsp(pg.price.value)}</p>
        <p class="includes">{pg.price.includes}</p>
        <p class="intro-note">{nbsp(pg.price.intro_note)}</p>
      </div>
    </section>

    <!-- 11. FAQ -->
    <section class="section faq">
      <h2>{pg.faq.heading}</h2>
      {pg.faq.items.map((f) => (
        <details><summary>{f.q}</summary><p>{f.a}</p></details>
      ))}
    </section>

    <!-- 12. second CTA -->
    <section class="section"><SupportCta /></section>

    <!-- 13. offer ladder -->
    <section class="section">
      <h2>{pg.ladder.heading}</h2>
      <div class="grid-2">
        {ladder.map((o) => <OfferCard offer={o} featured={o.key === 'session'} detailed />)}
      </div>
    </section>
  </div>
</Base>
<style>
  .intro { padding-top: 2rem; max-width: 52rem; }
  .intro h1 { font-size: clamp(2.25rem, 5vw, 3.4rem); }
  .two { align-items: start; gap: 1.5rem 2.5rem; }
  .two h2 { font-size: clamp(1.6rem, 3vw, 2.1rem); }
  .h3 { font-size: var(--fs-md) !important; }
  .proof { display: grid; gap: 2rem; align-items: center; }
  @media (min-width: 900px) { .proof { grid-template-columns: 1fr 1fr; gap: 3rem; } }
  .proof :global(.proof-photo) { width: 100%; height: auto; border-radius: var(--radius-lg); }
  .testimonials { list-style: none; margin: 0; padding: 0; }
  blockquote { margin: 0 0 0.6rem; }
  .who { font-weight: 700; font-size: 0.9rem; margin: 0; }
  .guarantee p { margin: 0; }
  .price-card {
    border: 2px solid var(--gold); border-radius: var(--radius-lg); background: var(--surface);
    padding: 1.5rem; text-align: center; display: flex; flex-direction: column; align-items: center;
  }
  .price { font-family: var(--font-display); font-weight: 900; font-size: clamp(3rem, 7vw, 4rem); line-height: 1; margin: 0 0 0.5rem; }
  .includes { margin: 0 0 0.4rem; }
  .intro-note { font-size: 0.82rem; color: var(--text-muted); margin: 0; }
  .faq { max-width: 46rem; }
  details { border-bottom: 1px solid var(--border); }
  summary { cursor: pointer; font-weight: 700; padding: 0.85rem 0; min-height: 24px; }
  details p { margin: 0 0 1rem; color: var(--text-muted); }
</style>
